{
  "ref": {
    "class_type": "GAReferenceImages",
    "inputs": {
      "paths": ""
    },
    "_meta": {
      "title": "参考图"
    }
  },
  "analyze": {
    "class_type": "GAReferenceAnalyze",
    "inputs": {
      "refs": [
        "ref",
        0
      ],
      "focus": "风格",
      "profile": "vision",
      "tag": ""
    },
    "_meta": {
      "title": "参考图分析"
    }
  },
  "style": {
    "class_type": "GAStyleCard",
    "inputs": {
      "path": "@repo/examples/style_cards/guochao.yaml"
    },
    "_meta": {
      "title": "风格卡"
    }
  },
  "expand": {
    "class_type": "GAPromptExpand",
    "inputs": {
      "brief": "",
      "asset_type": "icon",
      "profile": "text",
      "style": [
        "style",
        0
      ],
      "tag": "",
      "ref_description": [
        "analyze",
        0
      ]
    },
    "_meta": {
      "title": "提示词扩写"
    }
  },
  "edit": {
    "class_type": "GACloudEdit",
    "inputs": {
      "refs": [
        "ref",
        0
      ],
      "prompt": [
        "expand",
        0
      ],
      "negative": [
        "expand",
        1
      ],
      "size": "1024x1024",
      "n": 1,
      "transparent": true,
      "profile": "image_edit",
      "meta": [
        "expand",
        2
      ],
      "tag": ""
    },
    "_meta": {
      "title": "云端改图"
    }
  },
  "bg": {
    "class_type": "GARemoveBackground",
    "inputs": {
      "image": [
        "edit",
        0
      ],
      "method": "none",
      "mask": [
        "edit",
        1
      ]
    },
    "_meta": {
      "title": "去背景"
    }
  },
  "save": {
    "class_type": "GASaveAsset",
    "inputs": {
      "image": [
        "bg",
        0
      ],
      "subfolder": "ga/ref_to_asset",
      "name": "asset",
      "mask": [
        "bg",
        1
      ],
      "meta": [
        "edit",
        2
      ],
      "clean_alpha": 0
    },
    "_meta": {
      "title": "保存资产"
    }
  },
  "show_prompt": {
    "class_type": "PreviewAny",
    "inputs": {
      "source": [
        "expand",
        0
      ]
    },
    "_meta": {
      "title": "查看正向提示词"
    }
  },
  "show_negative": {
    "class_type": "PreviewAny",
    "inputs": {
      "source": [
        "expand",
        1
      ]
    },
    "_meta": {
      "title": "查看反向提示词"
    }
  }
}
