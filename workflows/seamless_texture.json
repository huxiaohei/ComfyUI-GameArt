{
  "style": {
    "class_type": "GAStyleCard",
    "inputs": {
      "path": "@repo/examples/style_cards/sanguo_chibi.yaml"
    },
    "_meta": {
      "title": "风格卡"
    }
  },
  "ref": {
    "class_type": "GAReferenceImages",
    "inputs": {
      "paths": ""
    },
    "_meta": {
      "title": "参考图"
    }
  },
  "expand": {
    "class_type": "GAPromptExpand",
    "inputs": {
      "brief": "",
      "asset_type": "texture",
      "profile": "text",
      "style": [
        "style",
        0
      ],
      "tag": ""
    },
    "_meta": {
      "title": "提示词扩写"
    }
  },
  "gen": {
    "class_type": "GACloudGenerate",
    "inputs": {
      "prompt": [
        "expand",
        0
      ],
      "negative": [
        "expand",
        1
      ],
      "size": "1024x1024",
      "n": 1,
      "transparent": false,
      "seed": -1,
      "profile": "image",
      "refs": [
        "ref",
        0
      ],
      "meta": [
        "expand",
        2
      ],
      "tag": "",
      "edit_profile": "image_edit"
    },
    "_meta": {
      "title": "云端生图"
    }
  },
  "seamless": {
    "class_type": "GAMakeSeamless",
    "inputs": {
      "image": [
        "gen",
        0
      ],
      "blend": 0.25,
      "mask": [
        "gen",
        1
      ]
    },
    "_meta": {
      "title": "无缝贴图"
    }
  },
  "save": {
    "class_type": "GASaveAsset",
    "inputs": {
      "image": [
        "seamless",
        0
      ],
      "subfolder": "ga/seamless_texture",
      "name": "texture",
      "mask": [
        "seamless",
        1
      ],
      "meta": [
        "gen",
        2
      ],
      "clean_alpha": 0
    },
    "_meta": {
      "title": "保存资产"
    }
  },
  "show_prompt": {
    "class_type": "PreviewAny",
    "inputs": {
      "source": [
        "expand",
        0
      ]
    },
    "_meta": {
      "title": "查看正向提示词"
    }
  },
  "show_negative": {
    "class_type": "PreviewAny",
    "inputs": {
      "source": [
        "expand",
        1
      ]
    },
    "_meta": {
      "title": "查看反向提示词"
    }
  },
  "show_tiled": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "seamless",
        2
      ]
    },
    "_meta": {
      "title": "铺开看接缝"
    }
  }
}
